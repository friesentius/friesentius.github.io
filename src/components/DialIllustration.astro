---
// An illustrative drawing of a touch dial for the Neokeys case study. It is
// labelled as a drawing on the page and is never presented as a screenshot;
// the key layout is invented for the illustration.
const keys = ['a', 's', 'd', 'f', 'j', 'k', 'l', ';'];
const C = 150;
const R_OUT = 128;
const R_IN = 54;
const GAP = 0.06; // radians between wedges
const pt = (r: number, a: number) =>
  `${(C + r * Math.cos(a)).toFixed(1)} ${(C + r * Math.sin(a)).toFixed(1)}`;
const wedges = keys.map((k, i) => {
  const mid = (i / keys.length) * Math.PI * 2 - Math.PI / 2;
  const half = Math.PI / keys.length - GAP;
  const a0 = mid - half;
  const a1 = mid + half;
  const d = `M${pt(R_IN, a0)} L${pt(R_OUT, a0)} A${R_OUT} ${R_OUT} 0 0 1 ${pt(R_OUT, a1)} L${pt(R_IN, a1)} A${R_IN} ${R_IN} 0 0 0 ${pt(R_IN, a0)} Z`;
  const [x, y] = pt(92, mid).split(' ');
  return { k, d, x, y, i };
});
---

<div class="illus">
  <span class="illus-tag">Illustrative drawing, not a screenshot</span>
  <svg
    viewBox="0 0 300 300"
    role="group"
    aria-label="Illustration of a touch dial: eight keys around a leader key"
  >
    <circle class="ripple" cx="150" cy="150" r="140" aria-hidden="true"></circle>
    <circle class="ripple r2" cx="150" cy="150" r="140" aria-hidden="true"></circle>
    {wedges.map((w) => (
      <g class="key" role="button" tabindex="0" aria-label={`key ${w.k}`} data-key={w.k}>
        <path class="wedge seq" style={`--d:${w.i}`} d={w.d} />
        <text class="klab" x={w.x} y={w.y} aria-hidden="true">
          {w.k}
        </text>
      </g>
    ))}
    <circle class="hubc" cx="150" cy="150" r="40" aria-hidden="true"></circle>
    <text class="hubt" x="150" y="150" aria-hidden="true">
      LEAD
    </text>
  </svg>
  <p class="illus-cap" id="dialCap" aria-live="polite">
    Tap a key to try it. The key layout is illustrative.
  </p>
</div>
