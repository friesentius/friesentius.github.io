---
// Small decorative drawing for a project tile (home) or card (Work index).
// Still until the tile or card is hovered, focused or opened; calm under
// reduced motion.
interface Props {
  kind: 'dial' | 'kanso' | 'pot' | 'bars';
  /** `card` is the larger, square frame of the Work index. */
  size?: 'tile' | 'card';
}

const { kind, size = 'tile' } = Astro.props;
// A quarter-circle dial anchored in the bottom right corner, like the real
// touch dial: the first keys on an inner ring, the next ring out beyond them.
const HUB = 52;
const ring = (r: number) => `M${HUB - r} ${HUB} A${r} ${r} 0 0 1 ${HUB} ${HUB - r}`;
const keyAt = (k: string, r: number, deg: number, d: number) => {
  const a = (deg * Math.PI) / 180;
  return { k, d, x: +(HUB + r * Math.cos(a)).toFixed(1), y: +(HUB + r * Math.sin(a)).toFixed(1) };
};
const keyPos = [
  keyAt('f', 24, 195, 0),
  keyAt('t', 24, 225, 1),
  keyAt('w', 24, 255, 2),
  keyAt('h', 40, 195, 3),
  keyAt('l', 40, 215, 4),
  keyAt('2', 40, 235, 5),
  keyAt('3', 40, 255, 6),
];
---

<span class={size === 'card' ? 'wv' : 'tile-v'} aria-hidden="true">
  {kind === 'dial' && (
    <svg class="dial" viewBox="6 6 60 60">
      <path d={ring(24)} fill="none" stroke="currentColor" stroke-opacity=".25" />
      <path d={ring(40)} fill="none" stroke="currentColor" stroke-opacity=".25" />
      {keyPos.map((p) => (
        <>
          <circle class="k" style={`--d:${p.d}`} cx={p.x} cy={p.y} r="5.5" />
          <text x={p.x} y={p.y}>
            {p.k}
          </text>
        </>
      ))}
      <circle class="hub" cx={HUB} cy={HUB} r="5" />
    </svg>
  )}
  {kind === 'kanso' && (
    <span class="kanso">
      {[0, 1, 2, 3].map((d) => (
        <i style={`--d:${d}`} />
      ))}
      <span class="sw">
        <b />
        <b />
        <b />
      </span>
    </span>
  )}
  {kind === 'pot' && (
    <svg class="pot" viewBox="0 0 56 56">
      <path class="st" style="--d:0" d="M20 18c-3-3 3-5 0-9" />
      <path class="st" style="--d:1" d="M28 18c-3-3 3-5 0-9" />
      <path class="st" style="--d:2" d="M36 18c-3-3 3-5 0-9" />
      <path
        class="body"
        d="M8 26h40 M12 26v14a6 6 0 0 0 6 6h20a6 6 0 0 0 6-6V26 M8 26h-3 M48 26h3"
      />
    </svg>
  )}
  {kind === 'bars' && (
    <span class="bars">
      {[40, 75, 55, 90, 65].map((h, d) => (
        <i style={`height:${h}%;--d:${d}`} />
      ))}
    </span>
  )}
</span>
