---
// Filled in by src/scripts/boot.ts. Hidden from assistive technology: the
// page underneath is complete and reachable the whole time.
---

<div id="boot" aria-hidden="true">
  <div class="boot-in">
    <div class="boot-top">
      <span>friesentius/boot</span>
      <button type="button" class="boot-skip" id="skipBoot" tabindex="-1">
        skip (any key)
      </button>
    </div>
    <div id="bootLog" class="boot-log"></div>
    <div class="boot-bar">
      <span id="bootBar"></span>
    </div>
  </div>
</div>
