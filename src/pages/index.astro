---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import BootOverlay from '../components/BootOverlay.astro';
import ContactPane from '../components/ContactPane.astro';
import CvPane from '../components/CvPane.astro';
import HeroPane from '../components/HeroPane.astro';
import MatrixPane from '../components/MatrixPane.astro';
import ShellPane from '../components/ShellPane.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TopBar from '../components/TopBar.astro';
import WorkPane from '../components/WorkPane.astro';
import { site } from '../data/site';
import type { ShellConfig } from '../lib/shell';
import type { BootLine } from '../scripts/boot';

const projects = (await getCollection('projects')).sort((a, b) => a.data.order - b.data.order);

// Everything the page script needs, generated from the same data as the panes.
const shell: ShellConfig = {
  handle: site.handle,
  name: site.name,
  email: site.email,
  github: site.github,
  company: { name: site.company.name, url: site.company.url },
  projects: [
    ...projects.map((p) => ({
      slug: p.id,
      summary: p.data.summary,
      target: `p-${p.id}`,
      expandable: true,
      url: p.data.site,
    })),
    {
      slug: 'matrix',
      summary: site.company.name,
      target: 'matrix',
      expandable: false,
      url: site.company.url,
      listing: 'matrix@',
    },
  ],
};

const boot: BootLine[] = [
  { label: 'probing display', value: 'display' },
  { label: 'mounting /work' },
  ...projects.map((p) => ({ label: `loading ${p.id}`, value: p.data.summary.replace(/\.$/, '') })),
  { label: 'linking matrix', value: new URL(site.company.url).host },
  { label: 'starting tty1' },
];

const words = [
  ...projects.filter((p) => p.id !== 'tools').map((p) => p.data.name),
  'Matrix Automation',
];
---

<Base title={site.handle} description={site.description} boot>
  <BootOverlay />
  <TopBar />
  <main id="main" class="wm" tabindex="-1">
    <HeroPane words={words} />
    <ShellPane />
    <WorkPane projects={projects} />
    <MatrixPane />
    <CvPane />
    <ContactPane />
  </main>
  <SiteFooter />
  <script
    type="application/json"
    id="site-data"
    set:html={
      // `<` is escaped so no string in the data can close this script element.
      JSON.stringify({ shell, boot }).replace(/</g, '\\u003c')
    }
  />
  <script>
    import { start } from '../scripts/home';
    start();
  </script>
</Base>
