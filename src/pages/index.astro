---
import Base from '../layouts/Base.astro';
import BootOverlay from '../components/BootOverlay.astro';
import ContactPane from '../components/ContactPane.astro';
import CvPane from '../components/CvPane.astro';
import HeroPane from '../components/HeroPane.astro';
import MatrixPane from '../components/MatrixPane.astro';
import ShellPane from '../components/ShellPane.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TopBar from '../components/TopBar.astro';
import WorkPane from '../components/WorkPane.astro';
import { getProjects, jsonForScript, shellConfig } from '../data/projects';
import { displayName, site } from '../data/site';
import type { BootLine } from '../scripts/boot';

const projects = await getProjects();

// Everything the page script needs, generated from the same data as the panes.
const shell = shellConfig(projects, 'home', '~');

const boot: BootLine[] = [
  { label: 'probing display', value: 'display' },
  { label: 'mounting /work' },
  ...projects.map((p) => ({ label: `loading ${p.id}`, value: p.data.typeLabel })),
  { label: 'linking matrix', value: new URL(site.company.url).host },
  { label: 'starting tty1' },
];

const words = [
  ...projects.filter((p) => p.id !== 'tools').map((p) => p.data.name),
  'Matrix Automation',
];
---

<Base title={`${displayName} - ${site.handle}`} description={site.description} boot>
  <BootOverlay />
  <TopBar current="home" />
  <main id="main" class="wm" tabindex="-1">
    <HeroPane words={words} />
    <ShellPane />
    <WorkPane projects={projects} />
    <MatrixPane />
    <CvPane />
    <ContactPane />
  </main>
  <SiteFooter />
  <script type="application/json" id="site-data" set:html={jsonForScript({ shell, boot })} />
  <script>
    import { start } from '../scripts/home';
    start();
  </script>
</Base>
