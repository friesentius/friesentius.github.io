---
import ContactEmail from '../components/ContactEmail.astro';
import Pane from '../components/Pane.astro';
import Placeholder from '../components/Placeholder.astro';
import Page from '../layouts/Page.astro';
import { cv, cvPdfPath } from '../data/cv';
import { site } from '../data/site';

// The web CV. It prints as a clean paper CV (the print rules at the end of
// global.css), and the build prints it to the downloadable PDF
// (scripts/cv-pdf.mjs), so the page is the PDF's only source.
const host = (url: string) => new URL(url).host;
---

<Page
  title="CV"
  description={`CV of ${site.name ?? site.handle}: experience, skills, education and contact.`}
  current="cv"
  cwd="~/cv"
  chips={['work', 'open neokeys', 'home', 'help']}
  promptIndex={5}
>
  <Pane
    id="cv-top"
    index={0}
    marker="2"
    title="~/cv"
    meta="cv.txt"
    class="cv-hero"
    bodyClass="page-head"
    labelledby="h-cv"
  >
    <p class="crumb no-print">
      <a href="/">~</a> / cv
    </p>
    <h1 class="page-h1" id="h-cv">
      {site.name ? <span data-scramble>{site.name}</span> : <Placeholder>[Full name]</Placeholder>}
    </h1>
    <p class="handle">
      <span data-scramble>{site.handle}</span>
    </p>
    {site.tagline && <p class="sub">{site.tagline}</p>}
    <p class="sub">
      {cv.summary ?? (
        <Placeholder>
          [Two or three sentence professional summary: what you do, what you are known for, what you
          are looking for]
        </Placeholder>
      )}
    </p>
    <div class="cta">
      <a class="btn" href={cvPdfPath} download>
        download CV (PDF)
      </a>
      <button class="btn ghost" type="button" id="printBtn">
        print this page
      </button>
    </div>
  </Pane>

  <Pane id="reach" index={1} marker="@" title="contact" meta="--list" class="cv-side">
    <ul class="kv">
      <li>
        <span class="k">email</span>
        <ContactEmail />
      </li>
      <li>
        <span class="k">github</span>
        <a href={site.github}>
          {host(site.github)}/{site.handle}
        </a>
      </li>
      <li>
        <span class="k">company</span>
        <a href={site.company.url}>{host(site.company.url)}</a>
      </li>
      <li>
        <span class="k">location</span>
        <span>{cv.location ?? <Placeholder>[City, Province]</Placeholder>}</span>
      </li>
      <li>
        <span class="k">web</span>
        <span>{site.plannedDomain} (planned)</span>
      </li>
    </ul>
  </Pane>

  <Pane
    id="experience"
    index={2}
    marker="01"
    title="experience"
    meta="git log --graph"
    class="cv-exp"
  >
    <p class="lead">
      <span class="pr">$</span> git log --graph cv.txt
    </p>
    <ol class="glog">
      {cv.experience.map((r, i) => (
        <li class="rv">
          <span class="node" aria-hidden="true" />
          <div>
            <p>
              <span class="hash">HEAD~{i}</span> <span class="when">{r.years}</span>
            </p>
            <p class="role">
              {r.title ?? <Placeholder>[Title]</Placeholder>} at {r.company}
            </p>
            {r.points === null ? (
              <ul>
                {[0, 1].map(() => (
                  <li>
                    <Placeholder>[Achievement or responsibility]</Placeholder>
                  </li>
                ))}
              </ul>
            ) : (
              r.points.length > 0 && (
                <ul>
                  {r.points.map((pt) => (
                    <li>{pt}</li>
                  ))}
                </ul>
              )
            )}
          </div>
        </li>
      ))}
    </ol>
  </Pane>

  <Pane
    id="skills"
    index={3}
    marker="02"
    title="skills"
    meta="grep -c"
    class="cv-skills"
    bodyClass="sk"
  >
    {cv.skills.map((g) => (
      <div>
        <h3>{g.heading}</h3>
        <ul class="chiprow">
          {g.skills.map((s) => (
            <li class="tagc">{s}</li>
          ))}
        </ul>
      </div>
    ))}
  </Pane>

  <Pane
    id="education"
    index={4}
    marker="03"
    title="education"
    meta="cat edu.txt"
    class="cv-edu rv"
    bodyClass="edu"
  >
    <ul>
      {cv.education.length ? (
        cv.education.map((e) => <li>{e}</li>)
      ) : (
        <li>
          <Placeholder>[Program], [Institution], [Year]</Placeholder>
        </li>
      )}
    </ul>
  </Pane>
</Page>

<script>
  import { setupPrint } from '../scripts/cv';
  setupPrint();
</script>
