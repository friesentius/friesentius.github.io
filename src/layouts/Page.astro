---
// Every page but home: the top bar, the tiled panes in the slot, the one-line
// prompt as the last pane, and the footer. No boot sequence; the panes tile
// in on load (decided before first paint in Base.astro).
import Base from './Base.astro';
import PromptPane from '../components/PromptPane.astro';
import SiteFooter from '../components/SiteFooter.astro';
import TopBar from '../components/TopBar.astro';
import { getProjects, shellConfig } from '../data/projects';
import { displayName } from '../data/site';

interface Props {
  /** Page name, e.g. "Work"; the owner's name is added after it. */
  title: string;
  description: string;
  /** The workspace tab to light; `none` for a page that has no tab (404). */
  current: 'work' | 'cv' | 'none';
  /** Working directory shown in the prompt, e.g. `~/work`. */
  cwd: string;
  /** Tappable commands under the prompt. */
  chips: string[];
  /** Tiling position of the prompt pane, after the page's own panes. */
  promptIndex: number;
  /** Keep the page out of search engines (the 404 page). */
  noindex?: boolean;
}

const { title, description, current, cwd, chips, promptIndex, noindex = false } = Astro.props;
const shell = shellConfig(await getProjects(), 'page', cwd);
---

<Base title={`${title} - ${displayName}`} description={description} noindex={noindex}>
  <TopBar current={current} />
  <main id="main" class="wm" tabindex="-1">
    <slot />
    <PromptPane index={promptIndex} cwd={cwd} chips={chips} shell={shell} />
  </main>
  <SiteFooter />
  <script>
    import { start } from '../scripts/page';
    start();
  </script>
</Base>
