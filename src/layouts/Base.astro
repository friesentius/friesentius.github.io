---
import '../styles/global.css';
import fontLatin from '@fontsource-variable/jetbrains-mono/files/jetbrains-mono-latin-wght-normal.woff2?url';
import { site } from '../data/site';
import { socialImage } from '../data/social';

interface Props {
  title: string;
  description: string;
  /** Play the boot sequence on this page (home only). */
  boot?: boolean;
  /**
   * Keep the page out of search engines and previews (the 404 page). It also
   * gets no canonical URL: it is served at every address that does not exist.
   */
  noindex?: boolean;
}

const { title, description, boot = false, noindex = false } = Astro.props;
// Every absolute URL comes from the one `site` value in astro.config.mjs, so
// moving to friesentius.com is a one-line change there.
const canonical = noindex ? undefined : new URL(Astro.url.pathname, Astro.site);
const image = new URL(socialImage.path, Astro.site);
---

<!doctype html>
<html lang="en" data-boot={boot ? '' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="dark light" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="en_CA" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:site_name" content={site.handle} />
    <meta property="og:image" content={image} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content={String(socialImage.width)} />
    <meta property="og:image:height" content={String(socialImage.height)} />
    <meta property="og:image:alt" content={socialImage.alt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />
    <meta name="twitter:image:alt" content={socialImage.alt} />
    <meta name="theme-color" content="#070a08" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f2ede1" media="(prefers-color-scheme: light)" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <slot name="head" />
    <link rel="preload" href={fontLatin} as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <!--
      Runs before first paint (inline, not bundled, so it is not deferred):
      applies the saved theme and motion choice and decides whether the boot
      sequence plays. The boot plays once per browser session, never under
      reduced motion, and the panes stay laid out underneath it.
    -->
    <script is:inline>
      (() => {
        const r = document.documentElement;
        try {
          const t = localStorage.getItem('fs-theme');
          if (t === 'light' || t === 'dark') r.setAttribute('data-theme', t);
          if (localStorage.getItem('fs-motion') === 'reduced')
            r.setAttribute('data-motion', 'reduced');
        } catch {
          // Storage blocked: fall back to the OS theme and motion settings.
        }
        r.classList.add('js');
        const calm =
          matchMedia('(prefers-reduced-motion: reduce)').matches ||
          r.getAttribute('data-motion') === 'reduced';
        if (calm) r.classList.add('calm');
        // Pages without the boot tile their panes in from the first frame.
        else if (!r.hasAttribute('data-boot')) r.classList.add('tiled');
        let seen = true;
        try {
          seen = sessionStorage.getItem('fs-booted') === '1';
        } catch {
          // No session storage: skip the boot rather than replay it every load.
        }
        if (!calm && !seen && r.hasAttribute('data-boot')) {
          r.classList.add('booting');
          // Safety net: never leave the page hidden if the page script fails to load.
          setTimeout(() => {
            if (!r.classList.contains('boot-live')) r.classList.remove('booting');
          }, 4000);
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">
      Skip to content
    </a>
    <slot />
  </body>
</html>
